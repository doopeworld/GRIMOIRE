LABEL org.opencontainers.image.source="https://github.com/doopeworld/GRIMOIRE" \
      org.opencontainers.image.revision="dd33cbe69b3b91f544011350e473a89500a9b13b" \
      org.opencontainers.image.version="v1.10.4-rc1"
COPY --chmod=0755 bin/grimoire bin/grimoire-server bin/libgrimoire_gemm.so /grimoire/bin/
