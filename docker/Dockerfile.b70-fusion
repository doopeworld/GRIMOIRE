# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=my-vllm-xpu:fusion-runtime
FROM ${BASE_IMAGE}

USER root
COPY docker/patches/vllm-dflash-b70-compact.patch /tmp/
RUN cd /opt/venv/lib/python3.12/site-packages \
 && patch -p1 --forward < /tmp/vllm-dflash-b70-compact.patch \
 && python3 -m py_compile \
      vllm/v1/worker/gpu/spec_decode/dflash/speculator.py \
 && rm /tmp/vllm-dflash-b70-compact.patch

ENV PATH=/opt/intel/oneapi/compiler/2026.1/bin:/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/venv/lib:/opt/intel/oneapi/ccl/latest/lib:/opt/intel/oneapi/mpi/latest/lib:/opt/intel/oneapi/tcm/1.5/lib:/opt/intel/oneapi/umf/1.1/lib:/opt/intel/oneapi/compiler/2026.1/lib:/opt/intel/oneapi/compiler/2026.1/opt/compiler/lib:/usr/local/lib \
    VLLM_TARGET_DEVICE=xpu \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    VLLM_XPU_ENABLE_XPU_GRAPH=1 \
    VLLM_USE_V2_MODEL_RUNNER=1

WORKDIR /opt/grimoire
ENTRYPOINT ["/bin/bash", "-lc", "source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1; exec /opt/venv/bin/vllm serve \"$@\"", "--"]
