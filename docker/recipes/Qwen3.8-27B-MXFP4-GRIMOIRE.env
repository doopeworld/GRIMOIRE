# Canonical Qwen3.8-27B-MXFP4 flags. Source: QWEN-RECIPE.md, verified
# 2026-09-01 at PP 4096 = 2539.8 tok/s, MTP(k=3) TG = 49.8 tok/s.
#
# Applied by grimoire-server/grimoire at startup when --model basename matches
# this file's name. A value already present in the environment always wins and
# is reported as an override, so the container can still experiment.
#
# llama-benchy generates after a ~4K-token prompt. At that depth, exact verify
# preserved 92% MTP acceptance and measured 37.6 tok/s in a1a92eb. The faster
# W4A8 verifier is preferable only for short prompts, where its precision loss
# does not collapse acceptance.
# Do NOT add GRIMOIRE_DEFER_MOE_GATHER / BF16_QKV / BF16_DN_QKV: those are
# Ornith flags and cut Qwen MTP decode from 49.8 to 18.3 tok/s.
GRIMOIRE_W4A8=1
GRIMOIRE_MTP=1
GRIMOIRE_MTP_K=3
GRIMOIRE_MTP_DRAFT_VOCAB=131072
GRIMOIRE_MTP_EXACT_VERIFY=1
GRIMOIRE_MTP_ZERO_CACHE=1
GRIMOIRE_DECODE_GRAPH=1

# Prints per-request [spec] acceptance + draft/verify split to the log.
# Diagnostic only, no effect on the decode path.
GRIMOIRE_MTP_PROFILE=1
