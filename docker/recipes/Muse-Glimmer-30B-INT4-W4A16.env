# Muse-Glimmer-30B-INT4-W4A16. Captured from the working GRIMOIRE-MUSE
# container on 2026-09-04 (the config that produced PP 2097 tok/s).
#
# attention_raw, NOT attention_bridge: Muse has been validated on the raw
# attention path. Do not "upgrade" this to attention_bridge without measuring
# Muse specifically -- the two bridges are not interchangeable.
GRIMOIRE_XE2_ATTN_BRIDGE=/opt/grimoire/lib/libgrimoire_xe2_attention_raw.so
GRIMOIRE_DFLASH_MODEL=/models/Muse-Glimmer-assistant
GRIMOIRE_MUSE_DRAFT_MXFP4=1
